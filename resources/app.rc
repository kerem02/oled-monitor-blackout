#include <windows.h>
#include "resource.h"
1 RT_MANIFEST "app.manifest"
IDI_APP ICON "app.ico"

IDD_SETTINGS DIALOGEX 0, 0, 534, 408
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MAXIMIZEBOX | WS_VSCROLL | WS_HSCROLL
CAPTION "OLED Blackout - Settings"
FONT 9, "Segoe UI"
BEGIN
    ICON IDI_APP, -1, 16, 14, 24, 24, SS_REALSIZECONTROL
    LTEXT "OLED Blackout", IDC_HEADER, 52, 13, 300, 19, SS_NOPREFIX
    LTEXT "Keep your OLED black while you use another display.", -1, 52, 36, 460, 12, SS_NOPREFIX
    LTEXT "", IDC_STATUS, 16, 57, 502, 18, SS_NOPREFIX

    GROUPBOX " OLED display ", -1, 12, 80, 510, 132
    LTEXT "&Choose the display to protect", IDC_DISPLAY_LABEL, 24, 96, 290, 12
    CONTROL "OLED displays", IDC_MONITORS, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 24, 112, 486, 58
    PUSHBUTTON "&Identify monitors", IDC_IDENTIFY, 24, 179, 108, 22, BS_NOTIFY
    PUSHBUTTON "&Refresh", IDC_REFRESH, 140, 179, 80, 22, BS_NOTIFY
    LTEXT "Numbers match Identify, not Windows Settings.", -1, 234, 181, 276, 25, SS_NOPREFIX

    GROUPBOX " Behavior ", -1, 12, 222, 510, 85
    LTEXT "Blackout &delay", -1, 24, 239, 85, 12
    COMBOBOX IDC_PRESET, 112, 235, 106, 110, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "&Seconds (5-3600)", -1, 232, 239, 101, 12
    EDITTEXT IDC_DELAY, 337, 235, 65, 21, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "&Enable automatic blackout", IDC_ENABLED, "Button", BS_AUTOCHECKBOX | BS_NOTIFY | WS_TABSTOP, 24, 264, 224, 16
    CONTROL "Ctrl+Alt+B &hotkey", IDC_HOTKEY, "Button", BS_AUTOCHECKBOX | BS_NOTIFY | WS_TABSTOP, 266, 264, 244, 16
    LTEXT "", IDC_HOTKEY_STATUS, 266, 284, 244, 15, SS_NOPREFIX

    GROUPBOX " Windows ", -1, 12, 317, 510, 48
    CONTROL "Start with &Windows", IDC_STARTUP, "Button", BS_AUTOCHECKBOX | BS_NOTIFY | WS_TABSTOP, 24, 332, 160, 17
    LTEXT "", IDC_STARTUP_STATUS, 192, 330, 318, 28, SS_NOPREFIX

    LTEXT "Blackout pauses while Settings is open.", IDC_FOOTER_HELP, 16, 376, 310, 12, SS_NOPREFIX
    DEFPUSHBUTTON "&Save", IDOK, 350, 371, 80, 22, BS_NOTIFY
    PUSHBUTTON "Cancel", IDCANCEL, 438, 371, 80, 22, BS_NOTIFY
END

1 VERSIONINFO
FILEVERSION 2,1,0,0
PRODUCTVERSION 2,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "Kerem Albayrak\0"
   VALUE "FileDescription", "OLED Blackout\0"
   VALUE "FileVersion", "2.1.0\0"
   VALUE "InternalName", "OLEDBlackout\0"
   VALUE "LegalCopyright", "Copyright (c) 2026 Kerem Albayrak. MIT License.\0"
   VALUE "OriginalFilename", "OLEDBlackout.exe\0"
   VALUE "ProductName", "OLED Blackout\0"
   VALUE "ProductVersion", "2.1.0\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
